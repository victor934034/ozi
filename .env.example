ANTHROPIC_API_KEY=coloque_sua_chave_aqui
JARVIS_WS_PORT=8787
JARVIS_WEB_PORT=8788
CLAUDE_MODEL=claude-sonnet-5

# --- Texto pra voz (TTS) ---
TTS_PROVIDER=fish-audio
FISH_AUDIO_API_KEY=coloque_sua_chave_da_fish_audio_aqui
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_FORMAT=wav
FISH_AUDIO_LATENCY=balanced
# FISH_AUDIO_VOICE_ID=id_de_uma_voz_da_biblioteca_fish_audio (opcional)
FISH_AUDIO_MAX_CONCORRENTE=5

# --- Contas de usuario (login) ---
JWT_SECRET=gere_com_openssl_rand_hex_32_ou_similar
# Preencha depois de criar um projeto em console.firebase.google.com, pra
# habilitar "Entrar com Google" no app.
GOOGLE_CLIENT_ID=

# --- Smart Life (Tuya) ---
# Pegue em https://iot.tuya.com -> Cloud -> Development -> seu projeto -> Overview
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_PROJECT_CODE=
# Endpoint depende do "Data Center" escolhido ao criar o projeto:
#   China: https://openapi.tuyacn.com
#   Western America: https://openapi.tuyaus.com
#   Eastern America: https://openapi-ueaz.tuyaus.com
#   Central Europe: https://openapi.tuyaeu.com
#   Western Europe: https://openapi-weaz.tuyaeu.com
#   India: https://openapi.tuyain.com
TUYA_ENDPOINT=
# Cuidado: sua conta do Smart Life pode nao estar no data center que voce
# esperaria pelo pais - se o "Link App Account" der erro de data center,
# so da pra descobrir o certo testando (o plano gratuito so permite 1 data
# center por vez, entao pode ter que apagar e recriar o projeto).
#
# UID da conta Smart Life vinculada (painel Tuya -> aba Devices -> Link App
# Account -> coluna "UID", depois de vincular sua conta com sucesso).
TUYA_UID=
